+// Local patch: career.<domain> is served headless; the filled form lives on a
+// virtual display exposed via noVNC at apply.<domain>. Open it in its own window
+// on the user's click (synchronously, so popup blockers allow it).
+function openApplyViewer() {
+  try {
+    const h = window.location.hostname;
+    if (!h.startsWith("career.")) return;
+    const url = `${window.location.protocol}//apply.${h.slice("career.".length)}/vnc.html?autoconnect=true&resize=scale&reconnect=true`;
+    window.open(url, "career-ops-apply-viewer", "popup,width=1320,height=960");
+  } catch {
+    /* viewer is a convenience */
+  }
+}
